# ccy.env — per-project ccy environment.
#
# Sourced INSIDE the disposable ccy container by the ccy launcher, never on
# the host. Created by the hooks-daemon ccy supervisor deploy (Plan 00147/00148).

# --- Plan 00135 PTY supervisor (armed by the hooks-daemon ccy deploy) ---
# ARMED: the supervisor watches the daemon-written context sidecar and, when
# the context goes RED and the session is idle, injects a REAL `/compact`; on
# any compaction it injects `continue` to resume. Supervisor-injected prompts
# are prefixed `🤖 [ccy-supervisor <timestamp>]` so they are obviously bot
# messages and show when they were injected.
#
# To DRY-RUN (harmless visible marker instead of a real /compact): drop the
# `--arm` below. To DISABLE entirely: comment the next line. Relaunch ccy after
# either change. This line is left untouched on future upgrades once present.
export CCY_CLAUDE_WRAPPER="${CCY_CLAUDE_WRAPPER:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/claude-supervise --arm --}"
